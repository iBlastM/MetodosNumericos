@using SistemasDeEcuaciones

<h3 class="text-center">Actividad 4 - Solución de Sistemas de ecuaciones</h3>

<div class="container mt-5">

    <div class="d-flex justify-content-center">
        <div class="card shadow-lg p-4" style="max-width: 600px; width: 100%;">
            <h4 class="card-title text-center">Ingresar Sistema de Ecuaciones</h4>
            <EditForm Model="this" OnValidSubmit="@GenerarMatrizAmpliada">
                <div class="mb-3">
                    <label for="ecuaciones" class="form-label">Introduce el sistema de ecuaciones:</label>
                    <input type="text" id="ecuaciones" class="form-control"
                           @bind-value="TempSistemaEcuaciones"
                           @bind-value:event="oninput"
                           placeholder="Ejemplo: x + y + z = 25, 5x + 3y + 2z = 0, y - z = 6" />
                </div>
                <button type="submit" class="btn btn-primary">Introducir</button>
            </EditForm>

            @if (!string.IsNullOrEmpty(mensajeErrorEntradaSistema))
            {
                <div class="alert alert-danger mt-2">@mensajeErrorEntradaSistema</div>
            }

            @if (!string.IsNullOrEmpty(SistemaEcuaciones) && MatrizAmpliada != null)
            {
                <div class="mt-3">
                    <h6>Entrada como Sistema de Ecuaciones:</h6>
                    <pre>@MostrarSistemaEcuaciones()</pre>
                </div>

                <div class="mt-3">
                    <h6>Matriz Ampliada:</h6>
                    <pre>@MostrarMatrizAmpliada()</pre>
                </div>
            }
        </div>
    </div>
</div>