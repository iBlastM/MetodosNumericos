@using SistemasDeEcuaciones

<h3 class="text-center">Actividad 4 - Solución de Sistemas de ecuaciones</h3>

<div class="container mt-5">

    <div class="d-flex justify-content-center">
        <div class="card shadow-lg p-4" style="width: 100%;">
            <h4 class="card-title text-center">Ingresar Sistema de Ecuaciones</h4>
            <EditForm Model="this" OnValidSubmit="@GenerarMatrizAmpliada">
                <div class="mb-3">
                    <label for="ecuaciones" class="form-label">Introduce el sistema de ecuaciones:</label>
                    <input type="text" id="ecuaciones" class="form-control"
                    @bind-value="TempSistemaEcuaciones"
                    @bind-value:event="oninput"
                    placeholder="Ejemplo: x + y + z = 25, 5x + 3y + 2z = 0, y - z = 6" />
                </div>
                <button type="submit" class="btn btn-primary">Introducir</button>
            </EditForm>

            @if (!string.IsNullOrEmpty(mensajeErrorEntradaSistema))
            {
                <div class="alert alert-danger mt-2">@mensajeErrorEntradaSistema</div>
            }

            @if (!string.IsNullOrEmpty(SistemaEcuaciones) && MatrizAmpliada != null)
            {
                <div class="mt-3">
                    <h6>Entrada como Sistema de Ecuaciones:</h6>
                    <pre>@MostrarSistemaEcuaciones()</pre>
                </div>

                <div class="mt-3">
                    <h6>Matriz Ampliada:</h6>
                    <pre>@MostrarMatrizAmpliada(MatrizAmpliadaInicial)</pre>
                </div>
            }
        </div>
    </div>
</div>

<div class="solution-options card card-form mt-4">
    <h5 class="card-title">Calculo de soluciones</h5>

    <!-- Selección de método del calculo de soluciones -->
    <label for="metodo">Seleccione el método de calculo de soluciones:</label>
    <select id="metodo" class="form-control" @bind="metodoSeleccionado">
        <option value="HaciaAtras">Eliminación Gaussiana con sustitución hacia atrás</option>
        <option value="PivoteoMaximo">Eliminación Gaussiana con Pivoteo Máximo de Columnas</option>
        <option value="PivoteoEscalado">Eliminación Gaussiana con Pivoteo Escalado de Columna.</option>
    </select>

    <div class="d-flex justify-content-center mt-3">
        <button class="btn btn-success" @onclick="CalcularSoluciones">Calcular soluciones del sistema</button>

    </div>
    @if (!string.IsNullOrEmpty(mensajeErrorNoHayMatriz))
    {
        <div class="alert alert-danger mt-2">@mensajeErrorNoHayMatriz</div>
    }
    @if (errorMatrizNoCuadrada)
    {
        <div class="alert alert-danger mt-2">La matriz introducida no es una matriz cuadrada, por favor ingrese una que sí lo sea.</div>
    }

    <!-- Mostrar resultado -->
    @if (tieneSolucion)
    {
        <div class="alert alert-info mt-3 text-center">
            @switch (metodoSeleccionado)
            {

                case "HaciaAtras":
                    <h6>Matriz Ampliada inicial:</h6>
                    <pre>@MostrarMatrizAmpliada(MatrizAmpliadaInicial)</pre>
                    int i = 1;
                    @foreach (var paso in pasos)
                    {
                        <p>Paso @i: @paso.operacion</p>
                        
                        @if(i <= pasos.Count - helpers.terminos.Count){
                            <h6>Matriz Ampliada despues del paso @i:</h6>
                            <pre>@MostrarMatrizAmpliada(paso.matriz)</pre>
                        }
                        
                        i++;
                    }
                    <h6>Soluciones: </h6>
                    @foreach(Termino termino in helpers.terminos){
                        <h6>@termino.Variable: @termino.Solucion</h6>
                    }
                    break;

                case "PivoteoMaximo":
                    <h6>Matriz Ampliada inicial:</h6>
                    <pre>@MostrarMatrizAmpliada(MatrizAmpliadaInicial)</pre>

                    
                    int j = 1;
             

                    @foreach (var paso in pasos)
                    {
                        <p>Paso @j: @paso.operacion</p>
    
                        @if (j <= pasos.Count - helpers.terminos.Count)
                        {
                            <h6>Matriz Ampliada después del paso @j:</h6>
                            <pre>@MostrarMatrizAmpliada(paso.matriz)</pre>
                        }
                        j++;
                    }

                    <h6>Soluciones: </h6>
                    @foreach(Termino termino in helpers.terminos){
                        <h6>@termino.Variable: @termino.Solucion</h6>
                    }


                    break;

                case "PivoteoEscalado":
                    <h6>Matriz Ampliada inicial:</h6>
                    <pre>@MostrarMatrizAmpliada(MatrizAmpliadaInicial)</pre>

                    int k = 1;

                    @foreach (var paso in pasos)
                    {
                        <p>Paso @k: @paso.operacion</p>

                        @if (k <= pasos.Count - helpers.terminos.Count)
                        {
                            <h6>Matriz Ampliada después del paso @k:</h6>
                            <pre>@MostrarMatrizAmpliada(paso.matriz)</pre>
                        }
                        k++;
                    }
                    <h6>Soluciones: </h6>
                    @foreach(Termino termino in helpers.terminos){
                        <h6>@termino.Variable: @termino.Solucion</h6>
                    }

                break;
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeErrorSistemaSinSolucion))
    {
        <div class="alert alert-danger mt-2">@mensajeErrorSistemaSinSolucion</div>
    }
</div>