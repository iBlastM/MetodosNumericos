@using NCalc
@using System.Globalization


<h3 class="mb-3">Calculadora de Integración Numérica</h3>

<div class="container">
    <div class="mb-3">
        <label class="form-label">Expresión matemática</label>
        <input class="form-control" @bind="ExpresionInicial" />
    </div>

    <div class="alert alert-info">
        <h5 class="mb-2">Ejemplos y Formato de Expresiones</h5>
        <ul class="mb-1">
            <li><code>3x^4 - 4x^3 - 12x^2 + 5</code></li>
            <li><code>Sin(x)</code>, <code>Cos(x)</code>, <code>Tan(x)</code> (Funciones trigonométricas en inglés)</li>
            <li><code>(8 + 3Sin(x))</code></li>
            <li><code>x * Log(x, e)</code> → log(x, e) = logaritmo natural </li>
            <li><code> e^(2x) * Sin(3x)</code></li>
            <li><code>x / ((x^2) + 4)</code></li>
            <li><code>e^x * Log(x, e)</code></li>
            <li><code>e^(x^2)</code></li>
            <li><code>e^x / x</code></li>
        </ul>
        <p class="mb-0 text-warning"><strong>Nota:</strong> Si quieres usar pi en los intervalos escribe "pi"</p>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Límite inferior (a)</label>
            <input class="form-control" @bind="a" />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Límite superior (b)</label>
            <input class="form-control" @bind="b" />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Número de subintervalos (n)</label>
            <input type="number" class="form-control" @bind="n" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Método</label>
        <select class="form-select" @bind="MetodoSeleccionado">
            <option value="trapecio_simple">Trapecio Simple</option>
            <option value="trapecio_compuesto">Trapecio Compuesto</option>
            <option value="simpson_13_simple">Simpson 1/3 Simple</option>
            <option value="simpson_13_compuesto">Simpson 1/3 Compuesto</option>
            <option value="simpson_38_simple">Simpson 3/8 Simple</option>
            <option value="simpson_38_compuesto">Simpson 3/8 Compuesto</option>
        </select>
    </div>

    <button class="btn btn-primary" @onclick="Calcular">Calcular</button>

    @if (!string.IsNullOrEmpty(mensajeErrorAlEvaluar))
    {
        <div class="alert alert-danger mt-2">@mensajeErrorAlEvaluar</div>
    }

    @if (!string.IsNullOrEmpty(mensajeErrorSubIntervalosNoValidos))
    {
        <div class="alert alert-danger mt-2">@mensajeErrorSubIntervalosNoValidos</div>
    }

    @if (resultado != null)
    {
        <div class="alert alert-success mt-4">
            Resultado: <strong>@resultado.Value.ToString("F6", CultureInfo.InvariantCulture)</strong>
        </div>
    }
</div>

<PlotlyChart @bind-Config="config" @bind-Layout="layout" @bind-Data="data" @ref="chart" />
